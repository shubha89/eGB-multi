include .gitignore README.md LICENSE CITATION.cff RELEASE_NOTES.md environment.yml
recursive-include docs *.md
recursive-include examples *.py *.ipynb
recursive-include tests *.py *.md *.txt *.json *.ipynb
prune tests/paper/data
prune tests/paper/reference_data
prune tests/results
prune tests/comparisons/vendor
global-exclude *.pyc .DS_Store *.[pP][dD][fF]
